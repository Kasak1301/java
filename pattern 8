import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scn= new Scanner(System.in);
        int n = scn.nextInt();
        int sp =n-2;
        for(int i=0;i<=(n-1);i++)
        {
            for(int j=0;j<=sp;j++){
                System.out.print("\t");
            }
            System.out.print("*\t");
            sp--;
            System.out.println();
        }
    }
}


