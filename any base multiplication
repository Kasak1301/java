        while(n1>0||n2>0||c>0){
            int dig1= n1 % 10;
            int dig2= n2 % 10;
            n1=n1 / 10;
            n2=n2 / 10;
            int d = dig1 + dig2 + c ;
            c=d/b;
            d=d% b;
            rv+=d*p;
            p=p*10;
        }
        return rv;
    }
