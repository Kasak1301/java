import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);

        System.out.println("enter the length of the array 1");
        int n1 = scn.nextInt();
        int[] a1 = new int[n1];
        System.out.println("enter the elements of array 1 ");
        for (int i = 0; i < a1.length; i++) {
            a1[i] = scn.nextInt();
        }
        System.out.println("array 1 created");

        System.out.println("enter the length of the array 2");
        int n2 = scn.nextInt();
        int[] a2 = new int[n2];
        System.out.println("enter the elements of array 2 ");
        for (int i = 0; i < a2.length; i++) {
            a2[i] = scn.nextInt();
        }
        System.out.println("array 2 created");

        // Result array will have the size of the larger array
        int maxLength = Math.max(n1, n2);
        int[] diff = new int[maxLength];

        int c = 0; // Carry for borrowing
        int i = a1.length - 1;
        int j = a2.length - 1;
        int k = diff.length - 1;

        while (k >= 0) {
            int val1 = i >= 0 ? a1[i] : 0; // Get value from array1 or 0 if i < 0
            int val2 = j >= 0 ? a2[j] : 0; // Get value from array2 or 0 if j < 0

            int d = 0; // Difference digit
            if (val2 + c >= val1) {
                d = val2 + c - val1;
                c = 0; // Reset carry
            } else {
                d = val2 + c + 10 - val1;
                c = -1; // Borrow from the next significant digit
            }

            diff[k] = d;
            i--;
            j--;
            k--;
        }

        // Skip leading zeros in the difference array
        int idx = 0;
        while (idx < diff.length && diff[idx] == 0) {
            idx++;
        }

        // Print the result
        if (idx == diff.length) {
            System.out.println(0); // If all elements are zero
        } else {
            while (idx < diff.length) {
                System.out.print(diff[idx]);
                idx++;
            }
            System.out.println(); // Move to the next line
        }
    }
}
