import java.util.*;
public class Main {
    // Function to find the next greater elements for each element in the array
    public static int[] nextGreaterElement(int[] nums) {
        int[] result = new int[nums.length];
        Stack<Integer> stack = new Stack<>();
        stack.push(0);
        result[0]=1;
        // Traverse the array from right to left
        for (int i = 1; i<nums.length; i++) {
            // Pop elements from the stack while they are smaller than or equal to the current element
            while (stack.size()>0 && nums[i]> nums[stack.peek()]) {
                stack.pop();
            }
            if(stack.size()==0){
                result[i]= i+1 ;
            }
            else{
                result[i] = i - stack.peek();
            }
            stack.push(i);

        }

        return result;
    }
    public static void main(String[] args) {
        Scanner scn = new Scanner (System.in);

        // Test input
        System.out.print("Enter the size of the array: ");
        int n = scn.nextInt();
        int[] nums = new int[n];

        System.out.println("Enter the elements of the array:");
        for (int i = 0; i < n; i++) {
            nums[i] = scn.nextInt();
        }
        // Find next greater elements
        int[] result = nextGreaterElement(nums);

        System.out.println("Input Array: " + Arrays.toString(nums));
        System.out.println("span: " + Arrays.toString(result));
    }
}
