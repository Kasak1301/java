import java.util.*;
public class Main{
    public static int getnewnumber (int n, int gbase, int rbase){
        int rv=0;
        int p=1;
        while(n>0){
            int dig= n%rbase;
            n=n/rbase;
            rv+=dig*p;
            p=p*gbase;
        }
        return rv;
    }
    public static void main(String[]args){
        Scanner scn= new Scanner(System.in);
        System.out.println("please enter the number");
        int n = scn.nextInt();
        System.out.println("please enter the base of the given no.");
        int gbase = scn.nextInt();
        System.out.println("please enter the base of the result no.");
        int rbase = scn.nextInt();
        int dtob= getnewnumber (n,gbase,rbase);
        System.out.println(dtob);
    }
}
